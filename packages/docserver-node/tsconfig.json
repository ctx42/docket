{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist/types",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // Node-bound host: node ambient types come from @types/node; no DOM.
    "lib": ["ES2022"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "test/**"],
  "references": [{ "path": "../core" }, { "path": "../docserver" }]
}
